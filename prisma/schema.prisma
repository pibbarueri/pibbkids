generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  password          String
  role              Role
  cpf               String?
  birthdate         DateTime?
  motherName        String?             @map("mother_name")
  phone             String?
  documentUrl       String?             @map("document_url")
  volunteerStatus   VolunteerStatus     @default(APROVADO) @map("volunteer_status")
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at")
  preferredClasses  UserPreferredClass[]
  functions         VolunteerFunction[]
  scheduleSlots     ScheduleSlot[]
  purchaseRequests  PurchaseRequest[]
  attendance        Attendance[]

  @@map("users")
}

enum Role {
  LIDERANCA
  COORDENACAO
  PROFESSOR
  AUXILIAR
  RECEPCAO

  @@map("role")
}

enum VolunteerStatus {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("volunteer_status")
}

model VolunteerFunction {
  userId   String       @map("user_id")
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  function FunctionType

  @@id([userId, function])
  @@map("volunteer_functions")
}

enum FunctionType {
  PROFESSOR
  AUXILIAR
  APOIO_GERAL
  LOUVOR
  RECEPCAO
  TEATRO

  @@map("function_type")
}

model UserPreferredClass {
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroupId String     @map("class_group_id")
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@id([userId, classGroupId])
  @@map("user_preferred_classes")
}

// ─── Crianças ─────────────────────────────────────────────────────────────────

model Child {
  id           String       @id @default(cuid())
  name         String
  birthdate    DateTime     @db.Date
  classGroupId String?      @map("class_group_id")
  classGroup   ClassGroup?  @relation(fields: [classGroupId], references: [id])
  frequency    Frequencia
  fatherName   String?      @map("father_name")
  motherName   String?      @map("mother_name")
  fatherPhone  String?      @map("father_phone")
  motherPhone  String?      @map("mother_phone")
  allergies    String?
  restrictions String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  attendance   Attendance[]

  @@map("children")
}

enum Frequencia {
  EBD
  CULTO
  AMBOS

  @@map("frequencia")
}

// ─── Turmas ───────────────────────────────────────────────────────────────────

model ClassGroup {
  id             String               @id @default(cuid())
  name           String               @unique
  ageRange       String?              @map("age_range")
  children       Child[]
  curricula      Curriculum[]
  scheduleSlots  ScheduleSlot[]
  sundayPlans    SundayPlan[]
  preferredBy    UserPreferredClass[]

  @@map("class_groups")
}

// ─── Currículos e Revistas ────────────────────────────────────────────────────

model Curriculum {
  id               String     @id @default(cuid())
  classGroupId     String     @map("class_group_id")
  classGroup       ClassGroup @relation(fields: [classGroupId], references: [id])
  semester         Int
  year             Int
  seriesType       SeriesType @map("series_type")
  seriesNumber     Int        @map("series_number")
  title            String
  totalWeeks       Int        @map("total_weeks")
  uso              Frequencia
  copiasProfessor  Int        @default(0) @map("copias_professor")
  copiasAluno      Int        @default(0) @map("copias_aluno")
  comprarProfessor Int        @default(0) @map("comprar_professor")
  recursosVisuais  Boolean    @default(false) @map("recursos_visuais")
  sundayPlans      SundayPlan[]

  @@map("curriculums")
}

enum SeriesType {
  CULTO_INFANTIL
  MATERNAL
  PLUGUINHO
  JUNIORES
  DETETIVE

  @@map("series_type")
}

// Plano por domingo: EBD e Culto são entradas separadas para a mesma turma
model SundayPlan {
  id            String      @id @default(cuid())
  date          DateTime
  classGroupId  String      @map("class_group_id")
  classGroup    ClassGroup  @relation(fields: [classGroupId], references: [id])
  tipo          SundayTipo
  curriculumId  String?     @map("curriculum_id")
  curriculum    Curriculum? @relation(fields: [curriculumId], references: [id])
  licaoNumber   Int?        @map("licao_number")
  lessonType    LessonType  @default(APOSTILA) @map("lesson_type")
  specialTitle  String?     @map("special_title")
  done          Boolean     @default(false)

  @@unique([date, classGroupId, tipo])
  @@map("sunday_plans")
}

enum SundayTipo {
  EBD
  CULTO

  @@map("sunday_tipo")
}

enum LessonType {
  APOSTILA
  AULA_EXTRA
  CULTO_INFANTIL
  SEM_AULA
  TEMA_LIVRE

  @@map("lesson_type")
}

// ─── Escala ───────────────────────────────────────────────────────────────────

model ScheduleSlot {
  id           String      @id @default(cuid())
  date         DateTime
  slotType     SlotType    @map("slot_type")
  classGroupId String?     @map("class_group_id")
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id])
  role         SlotRole
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])

  @@unique([date, slotType, classGroupId, role, userId])
  @@map("schedule_slots")
}

enum SlotType {
  SALA_PLUS
  APOIO_EBD
  APOIO_CULTO
  LANCHE
  EBD
  CULTO

  @@map("slot_type")
}

enum SlotRole {
  PROFESSOR
  AUXILIAR

  @@map("slot_role")
}

// ─── Presença ─────────────────────────────────────────────────────────────────

model Attendance {
  id      String     @id @default(cuid())
  childId String     @map("child_id")
  child   Child      @relation(fields: [childId], references: [id])
  userId  String     @map("user_id")
  user    User       @relation(fields: [userId], references: [id])
  date    DateTime
  type    SundayTipo
  present Boolean

  @@unique([childId, date, type])
  @@map("attendance")
}

// ─── Materiais e Compras ──────────────────────────────────────────────────────

model Material {
  id          String            @id @default(cuid())
  name        String
  unit        String
  quantity    Int               @default(0)
  movements   StockMovement[]
  requests    PurchaseRequest[]

  @@map("materials")
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])
  delta      Int
  reason     String
  date       DateTime @default(now())

  @@map("stock_movements")
}

model PurchaseRequest {
  id            String        @id @default(cuid())
  requesterId   String        @map("requester_id")
  requester     User          @relation(fields: [requesterId], references: [id])
  materialId    String?       @map("material_id")
  material      Material?     @relation(fields: [materialId], references: [id])
  freeTextItem  String?       @map("free_text_item")
  quantity      Int
  unit          String?
  justification String?
  status        RequestStatus @default(PENDENTE)
  rejectionReason String?     @map("rejection_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("purchase_requests")
}

enum RequestStatus {
  PENDENTE
  APROVADO
  REJEITADO
  COMPRADO
  EM_ESTOQUE

  @@map("request_status")
}

// ─── Eventos ──────────────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?

  @@map("events")
}
