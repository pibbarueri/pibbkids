generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id                String              @id @default(cuid())
  name              String
  username          String?             @unique
  password          String?
  requirePasswordChange Boolean         @default(false) @map("require_password_change")
  role              Role
  cpf               String?
  birthdate         DateTime? @db.Date
  motherName        String?             @map("mother_name")
  phone             String?
  documentUrl       String?             @map("document_url")
  status            VolunteerStatus     @default(APPROVED) @map("status")
  active            Boolean             @default(true)
  inclusionEnabled  Boolean             @default(false) @map("inclusion_enabled")
  createdAt         DateTime            @default(now()) @map("created_at")
  preferredClasses  UserPreferredClass[]
  functions         VolunteerFunction[]
  scheduleSlots     ScheduleSlot[]
  purchaseRequests  PurchaseRequest[]
  attendance        Attendance[]
  sessions          UserSession[]
  occurrencesReported Occurrence[]      @relation("OccurrenceReporter")
  occurrencesResolved Occurrence[]      @relation("OccurrenceResolver")
  classJournalEntriesAuthored     ClassJournalEntry[] @relation("ClassJournalAuthor")
  classJournalEntriesAcknowledged ClassJournalEntry[] @relation("ClassJournalAcknowledger")
  settings          UserSettings?
  materialsCreated  Material[]          @relation("MaterialCreator")
  materialsUpdated  Material[]          @relation("MaterialUpdater")

  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  @@map("user_sessions")
}

// Per-user UI preferences. Kept as jsonb so new preferences don't need a migration;
// always read/write it through parseAppSettings() in src/lib/navigation.ts.
model UserSettings {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSettings Json     @default("{}") @map("app_settings") @db.JsonB
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  ASSISTANT
  RECEPTIONIST
  SUPPORT

  @@map("role")
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("volunteer_status")
}

model VolunteerFunction {
  userId   String       @map("user_id")
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  function FunctionType

  @@id([userId, function])
  @@map("volunteer_functions")
}

enum FunctionType {
  PROFESSOR
  AUXILIAR
  APOIO_GERAL
  LOUVOR
  RECEPCAO
  EVENTS
  IDE_KIDS
  MIDIAS_DESIGN

  @@map("function_type")
}

model UserPreferredClass {
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroupId String     @map("class_group_id")
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@id([userId, classGroupId])
  @@map("user_preferred_classes")
}

// ─── Crianças ─────────────────────────────────────────────────────────────────

model Child {
  id           String       @id @default(cuid())
  name         String
  birthdate    DateTime     @db.Date
  classGroupId String?      @map("class_group_id")
  classGroup   ClassGroup?  @relation(fields: [classGroupId], references: [id])
  frequency    Frequencia
  fatherName   String?      @map("father_name")
  motherName   String?      @map("mother_name")
  fatherPhone  String?      @map("father_phone")
  motherPhone  String?      @map("mother_phone")
  allergies    String?
  restrictions String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  attendance   Attendance[]

  @@map("children")
}

enum Frequencia {
  EBD
  CULTO
  AMBOS

  @@map("frequencia")
}

// ─── Turmas ───────────────────────────────────────────────────────────────────

model ClassGroup {
  id             String               @id @default(cuid())
  name           String               @unique
  ageRange       String?              @map("age_range")
  children       Child[]
  journals       Journal[]
  scheduleSlots  ScheduleSlot[]
  sundayPlans    SundayPlan[]
  preferredBy    UserPreferredClass[]
  journalEntries ClassJournalEntry[]

  @@map("class_groups")
}

// ─── Currículos e Revistas ────────────────────────────────────────────────────

// A revista: série + edição, adotada por uma turma para EBD, Culto ou ambos.
model Journal {
  id                 String       @id @default(cuid())
  title              String
  series             SeriesType
  edition            Int
  totalWeeks         Int?         @map("total_weeks")
  classGroupId       String       @map("class_group_id")
  classGroup         ClassGroup   @relation(fields: [classGroupId], references: [id])
  usage              Frequencia
  teacherCopies      Int          @default(0) @map("teacher_copies")
  studentCopies      Int          @default(0) @map("student_copies")
  hasVisualResources Boolean      @default(false) @map("has_visual_resources")
  sundayPlans        SundayPlan[]

  @@map("journals")
}

enum SeriesType {
  CULTO_INFANTIL
  MATERNAL
  PLUGUINHO
  JUNIORES
  DETETIVE

  @@map("series_type")
}

// Plano por domingo: EBD e Culto são entradas separadas para a mesma turma
model SundayPlan {
  id            String      @id @default(cuid())
  date          DateTime
  classGroupId  String      @map("class_group_id")
  classGroup    ClassGroup  @relation(fields: [classGroupId], references: [id])
  tipo          SundayTipo
  journalId     String?     @map("journal_id")
  journal       Journal?    @relation(fields: [journalId], references: [id])
  licaoNumber   Int?        @map("licao_number")
  lessonType    LessonType  @default(APOSTILA) @map("lesson_type")
  specialTitle  String?     @map("special_title")
  observations  String?
  done          Boolean     @default(false)

  @@unique([date, classGroupId, tipo])
  @@map("sunday_plans")
}

enum SundayTipo {
  EBD
  CULTO

  @@map("sunday_tipo")
}

enum LessonType {
  APOSTILA
  AULA_EXTRA
  REVIEW
  QUIZ_GINCANA
  SEM_AULA
  TEMA_LIVRE

  @@map("lesson_type")
}

// ─── Escala ───────────────────────────────────────────────────────────────────

model ScheduleSlot {
  id           String      @id @default(cuid())
  // A slot belongs to a calendar day, not an instant. As a timestamp the same Sunday
  // got written at two different times (UTC midnight by the import, local midnight by
  // the app), and equality filters then matched only one of the two sets.
  date         DateTime    @db.Date
  slotType     SlotType    @map("slot_type")
  horario      Frequencia?
  classGroupId String?     @map("class_group_id")
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id])
  role         SlotRole?
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])

  @@unique([date, slotType, horario, classGroupId, role, userId])
  @@map("schedule_slots")
}

enum SlotType {
  COORDENACAO
  SALA_PLUS
  RECEPCAO
  LANCHE
  INCLUSAO
  TURMA

  @@map("slot_type")
}

enum SlotRole {
  PROFESSOR
  AUXILIAR

  @@map("slot_role")
}

// ─── Presença ─────────────────────────────────────────────────────────────────

model Attendance {
  id      String     @id @default(cuid())
  childId String     @map("child_id")
  child   Child      @relation(fields: [childId], references: [id])
  userId  String     @map("user_id")
  user    User       @relation(fields: [userId], references: [id])
  date    DateTime
  type    SundayTipo
  present Boolean

  @@unique([childId, date, type])
  @@map("attendance")
}

// ─── Materiais e Compras ──────────────────────────────────────────────────────

model Material {
  id          String            @id @default(cuid())
  name        String
  description String?
  // Nullable because materials already registered before categories existed —
  // they show up as "Sem categoria" until someone edits them.
  categoryId  String?           @map("category_id")
  category    MaterialCategory? @relation(fields: [categoryId], references: [id])
  unit        String
  quantity    Int               @default(0)
  requests    PurchaseRequest[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("MaterialCreator", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("MaterialUpdater", fields: [updatedById], references: [id])

  @@index([categoryId])
  @@map("materials")
}

// A lookup table rather than an enum: adding or retiring a category is an INSERT/UPDATE
// by whoever runs the ministry, with no migration and no deploy. `active` hides a
// category from the pickers without breaking the materials that still reference it.
model MaterialCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  active    Boolean    @default(true)
  materials Material[]

  @@map("material_categories")
}

model PurchaseRequest {
  id            String        @id @default(cuid())
  requesterId   String        @map("requester_id")
  requester     User          @relation(fields: [requesterId], references: [id])
  materialId    String?       @map("material_id")
  material      Material?     @relation(fields: [materialId], references: [id])
  freeTextItem  String?       @map("free_text_item")
  quantity      Int
  unit          String?
  justification String?
  status        RequestStatus @default(PENDENTE)
  rejectionReason String?     @map("rejection_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("purchase_requests")
}

enum RequestStatus {
  PENDENTE
  APROVADO
  REJEITADO
  COMPRADO
  EM_ESTOQUE

  @@map("request_status")
}

// ─── Eventos ──────────────────────────────────────────────────────────────────

// Events are for everyone — no per-volunteer assignment.
model Event {
  id          String    @id @default(cuid())
  title       String
  date        DateTime
  endDate     DateTime? @map("end_date")
  description String?
  notes       String?   @map("notes")

  @@map("events")
}

// ─── Lanches ──────────────────────────────────────────────────────────────────

model Snack {
  id          String        @id @default(cuid())
  category    SnackCategory
  description String
  quantity    Int           @default(0)
  unit        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("snacks")
}

enum SnackCategory {
  COMIDA
  BEBIDA
  OUTROS

  @@map("snack_category")
}

// ─── Diário de Sala ─────────────────────────────────────────────────────────────

model ClassJournalEntry {
  id               String     @id @default(cuid())
  classGroupId     String     @map("class_group_id")
  classGroup       ClassGroup @relation(fields: [classGroupId], references: [id])
  title            String
  entryDate        DateTime   @db.Date @map("entry_date")
  description      String
  authorId         String     @map("author_id")
  author           User       @relation("ClassJournalAuthor", fields: [authorId], references: [id])
  acknowledgedById String?    @map("acknowledged_by_id")
  acknowledgedBy   User?      @relation("ClassJournalAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?  @map("acknowledged_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("class_journal_entries")
}

// ─── Ocorrências ──────────────────────────────────────────────────────────────

model Occurrence {
  id           String            @id @default(cuid())
  reporterId   String            @map("reporter_id")
  reporter     User              @relation("OccurrenceReporter", fields: [reporterId], references: [id])
  occurredAt   DateTime          @db.Date @map("occurred_at")
  context      OccurrenceContext
  details      String
  status       OccurrenceStatus  @default(EM_ANALISE)
  resolvedById String?           @map("resolved_by_id")
  resolvedBy   User?             @relation("OccurrenceResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("occurrences")
}

enum OccurrenceContext {
  EBD
  CULTO
  OUTRO

  @@map("occurrence_context")
}

enum OccurrenceStatus {
  EM_ANALISE
  RESOLVIDO

  @@map("occurrence_status")
}
