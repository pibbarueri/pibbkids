generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id                              String               @id @default(cuid())
  name                            String
  username                        String?              @unique
  password                        String?
  requirePasswordChange           Boolean              @default(false) @map("require_password_change")
  role                            Role
  cpf                             String?
  birthdate                       DateTime?            @db.Date
  motherName                      String?              @map("mother_name")
  phone                           String?
  documentUrl                     String?              @map("document_url")
  status                          VolunteerStatus      @default(APPROVED) @map("status")
  active                          Boolean              @default(true)
  inclusionEnabled                Boolean              @default(false) @map("inclusion_enabled")
  createdAt                       DateTime             @default(now()) @map("created_at")
  preferredClasses                UserPreferredClass[]
  functions                       VolunteerFunction[]
  scheduleSlots                   ScheduleSlot[]
  purchaseRequests                PurchaseRequest[]
  attendance                      Attendance[]
  sessions                        UserSession[]
  occurrencesReported             Occurrence[]         @relation("OccurrenceReporter")
  occurrencesResolved             Occurrence[]         @relation("OccurrenceResolver")
  classJournalEntriesAuthored     ClassJournalEntry[]  @relation("ClassJournalAuthor")
  classJournalEntriesAcknowledged ClassJournalEntry[]  @relation("ClassJournalAcknowledger")
  settings                        UserSettings?
  materialsCreated                Material[]           @relation("MaterialCreator")
  materialsUpdated                Material[]           @relation("MaterialUpdater")
  visitorsLogged                  Visitor[]
  notifications                   Notification[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("user_sessions")
}

// Per-user UI preferences. Kept as jsonb so new preferences don't need a migration;
// always read/write it through parseAppSettings() in src/lib/navigation.ts.
model UserSettings {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSettings Json     @default("{}") @map("app_settings") @db.JsonB
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

// Per-user "last seen" marker for a notification category (e.g. "occurrences",
// "purchase-requests") — lets a nav dot clear when the user visits the relevant screen,
// without a full notification inbox.
model Notification {
  userId String   @map("user_id")
  key    String
  seenAt DateTime @default(now()) @map("seen_at")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("notifications")
}

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  ASSISTANT
  RECEPTIONIST
  SUPPORT

  @@map("role")
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("volunteer_status")
}

model VolunteerFunction {
  userId   String       @map("user_id")
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  function FunctionType

  @@id([userId, function])
  @@map("volunteer_functions")
}

enum FunctionType {
  TEACHER
  ASSISTANT
  SUPPORT
  WORSHIP
  RECEPTION
  EVENTS
  IDE_KIDS
  MEDIA_DESIGN

  @@map("function_type")
}

model UserPreferredClass {
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroupId String     @map("class_group_id")
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@id([userId, classGroupId])
  @@map("user_preferred_classes")
}

// ─── Children ─────────────────────────────────────────────────────────────────

model Child {
  id           String       @id @default(cuid())
  name         String
  birthdate    DateTime     @db.Date
  classGroupId String?      @map("class_group_id")
  classGroup   ClassGroup?  @relation(fields: [classGroupId], references: [id])
  frequency    Frequency
  fatherName   String?      @map("father_name")
  motherName   String?      @map("mother_name")
  fatherPhone  String?      @map("father_phone")
  motherPhone  String?      @map("mother_phone")
  allergies    String?
  restrictions String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  attendance   Attendance[]
  visitor      Visitor?

  @@map("children")
}

enum Frequency {
  EBD
  CULTO
  AMBOS

  @@map("frequency")
}

// Quick same-day check-in for a visiting child (logged by RECEPTIONIST during EBD/Culto).
// No `date` column: createdAt IS the visit day — truncate with src/lib/dates.ts helpers
// (APP_TIME_ZONE) when grouping by day, never compare the raw timestamp.
model Visitor {
  id           String      @id @default(cuid())
  name         String
  birthdate    DateTime    @db.Date
  type         SundayType
  classGroupId String?     @map("class_group_id")
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id])
  createdById  String      @map("created_by_id")
  createdBy    User        @relation(fields: [createdById], references: [id])
  childId      String?     @unique @map("child_id")
  child        Child?      @relation(fields: [childId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("visitors")
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model ClassGroup {
  id             String               @id @default(cuid())
  name           String               @unique
  ageRange       String?              @map("age_range")
  children       Child[]
  journals       Journal[]
  scheduleSlots  ScheduleSlot[]
  sundayPlans    SundayPlan[]
  preferredBy    UserPreferredClass[]
  journalEntries ClassJournalEntry[]
  visitors       Visitor[]

  @@map("class_groups")
}

// ─── Curriculum & Journals ──────────────────────────────────────────────────────

// A journal: series + edition, adopted by a class for EBD, Culto, or both.
model Journal {
  id                 String       @id @default(cuid())
  title              String
  series             SeriesType
  edition            Int
  totalWeeks         Int?         @map("total_weeks")
  classGroupId       String       @map("class_group_id")
  classGroup         ClassGroup   @relation(fields: [classGroupId], references: [id])
  usage              Frequency
  teacherCopies      Int          @default(0) @map("teacher_copies")
  studentCopies      Int          @default(0) @map("student_copies")
  hasVisualResources Boolean      @default(false) @map("has_visual_resources")
  sundayPlans        SundayPlan[]

  @@map("journals")
}

enum SeriesType {
  CULTO_INFANTIL
  MATERNAL
  PLUGUINHO
  JUNIORES
  DETETIVE

  @@map("series_type")
}

// Plan per Sunday: EBD and Culto are separate entries for the same class
model SundayPlan {
  id           String     @id @default(cuid())
  date         DateTime
  classGroupId String     @map("class_group_id")
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  type         SundayType
  journalId    String?    @map("journal_id")
  journal      Journal?   @relation(fields: [journalId], references: [id])
  lessonNumber Int?       @map("lesson_number")
  lessonType   LessonType @default(WORKBOOK) @map("lesson_type")
  specialTitle String?    @map("special_title")
  observations String?
  done         Boolean    @default(false)

  @@unique([date, classGroupId, type])
  @@map("sunday_plans")
}

enum SundayType {
  EBD
  CULTO

  @@map("sunday_type")
}

enum LessonType {
  WORKBOOK
  EXTRA_CLASS
  REVIEW
  QUIZ_GAME
  NO_CLASS
  FREE_TOPIC

  @@map("lesson_type")
}

// ─── Schedule ─────────────────────────────────────────────────────────────────

model ScheduleSlot {
  id           String      @id @default(cuid())
  // A slot belongs to a calendar day, not an instant. As a timestamp the same Sunday
  // got written at two different times (UTC midnight by the import, local midnight by
  // the app), and equality filters then matched only one of the two sets.
  date         DateTime    @db.Date
  slotType     SlotType    @map("slot_type")
  timeSlot     Frequency?  @map("time_slot")
  classGroupId String?     @map("class_group_id")
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id])
  role         SlotRole?
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])

  @@unique([date, slotType, timeSlot, classGroupId, role, userId])
  @@map("schedule_slots")
}

enum SlotType {
  COORDINATOR
  ROOM_PLUS
  RECEPTION
  SNACK
  INCLUSION
  CLASS

  @@map("slot_type")
}

enum SlotRole {
  TEACHER
  ASSISTANT

  @@map("slot_role")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id      String     @id @default(cuid())
  childId String     @map("child_id")
  child   Child      @relation(fields: [childId], references: [id])
  userId  String     @map("user_id")
  user    User       @relation(fields: [userId], references: [id])
  date    DateTime
  type    SundayType
  present Boolean

  @@unique([childId, date, type])
  @@map("attendance")
}

// ─── Materials & Purchases ──────────────────────────────────────────────────────

model Material {
  id          String            @id @default(cuid())
  name        String
  description String?
  // Nullable because materials already registered before categories existed —
  // they show up as "Sem categoria" until someone edits them.
  categoryId  String?           @map("category_id")
  category    MaterialCategory? @relation(fields: [categoryId], references: [id])
  unit        String
  quantity    Int               @default(0)
  requests    PurchaseRequest[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("MaterialCreator", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("MaterialUpdater", fields: [updatedById], references: [id])

  @@index([categoryId])
  @@map("materials")
}

// A lookup table rather than an enum: adding or retiring a category is an INSERT/UPDATE
// by whoever runs the ministry, with no migration and no deploy. `active` hides a
// category from the pickers without breaking the materials that still reference it.
model MaterialCategory {
  id               String            @id @default(cuid())
  name             String            @unique
  sortOrder        Int               @default(0) @map("sort_order")
  active           Boolean           @default(true)
  materials        Material[]
  purchaseRequests PurchaseRequest[]

  @@map("material_categories")
}

model PurchaseRequest {
  id              String            @id @default(cuid())
  requesterId     String            @map("requester_id")
  requester       User              @relation(fields: [requesterId], references: [id])
  materialId      String?           @map("material_id")
  material        Material?         @relation(fields: [materialId], references: [id])
  categoryId      String?           @map("category_id")
  category        MaterialCategory? @relation(fields: [categoryId], references: [id])
  freeTextItem    String?           @map("free_text_item")
  description     String?
  quantity        Int
  unit            String?
  justification   String?
  status          RequestStatus     @default(PENDING)
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("purchase_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
  IN_STOCK

  @@map("request_status")
}

// ─── Events ───────────────────────────────────────────────────────────────────

// Events are for everyone — no per-volunteer assignment.
model Event {
  id          String    @id @default(cuid())
  title       String
  date        DateTime
  endDate     DateTime? @map("end_date")
  description String?
  notes       String?   @map("notes")

  @@map("events")
}

// ─── Snacks ───────────────────────────────────────────────────────────────────

model Snack {
  id          String        @id @default(cuid())
  category    SnackCategory
  description String
  quantity    Int           @default(0)
  minQuantity Int           @default(5) @map("min_quantity")
  unit        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("snacks")
}

enum SnackCategory {
  FOOD
  DRINK
  OTHER

  @@map("snack_category")
}

// ─── Class Journal ──────────────────────────────────────────────────────────────

model ClassJournalEntry {
  id               String            @id @default(cuid())
  classGroupId     String            @map("class_group_id")
  classGroup       ClassGroup        @relation(fields: [classGroupId], references: [id])
  title            String
  entryDate        DateTime          @map("entry_date") @db.Date
  context          OccurrenceContext @default(OUTRO)
  description      String
  authorId         String            @map("author_id")
  author           User              @relation("ClassJournalAuthor", fields: [authorId], references: [id])
  acknowledgedById String?           @map("acknowledged_by_id")
  acknowledgedBy   User?             @relation("ClassJournalAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?         @map("acknowledged_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@map("class_journal_entries")
}

// ─── Occurrences ──────────────────────────────────────────────────────────────

model Occurrence {
  id           String            @id @default(cuid())
  reporterId   String            @map("reporter_id")
  reporter     User              @relation("OccurrenceReporter", fields: [reporterId], references: [id])
  occurredAt   DateTime          @map("occurred_at") @db.Date
  context      OccurrenceContext
  details      String
  status       OccurrenceStatus  @default(UNDER_REVIEW)
  resolvedById String?           @map("resolved_by_id")
  resolvedBy   User?             @relation("OccurrenceResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("occurrences")
}

enum OccurrenceContext {
  EBD
  CULTO
  OUTRO

  @@map("occurrence_context")
}

enum OccurrenceStatus {
  UNDER_REVIEW
  RESOLVED

  @@map("occurrence_status")
}
